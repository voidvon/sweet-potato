{
  "name": "ai-marketing-desktop",
  "version": "4.2.0",
  "description": "AI marketing automation desktop app based on electron-egg and React",
  "main": "./public/electron/main.js",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; const execPath = process.env.npm_execpath || ''; if (!ua.includes('pnpm/') && !execPath.includes('pnpm')) { console.error('检测到正在使用 npm。请使用 pnpm install'); process.exit(1); }\"",
    "dev": "node ./scripts/dev.cjs",
    "dev:web": "pnpm --dir web run dev",
    "dev:admin": "pnpm --dir admin run dev",
    "build:web": "pnpm --dir web run build",
    "build:admin": "pnpm --dir admin run build",
    "build-web": "pnpm run build:web",
    "build-electron-frontend": "pnpm --dir web run build --mode electron",
    "build-electron": "pnpm run build-electron-frontend && ee-bin build --cmds=electron && ee-bin encrypt",
    "typecheck:web": "pnpm --dir web run typecheck",
    "typecheck:admin": "pnpm --dir admin run typecheck",
    "start": "ee-bin start",
    "dev-frontend": "ee-bin dev --serve=frontend",
    "dev-electron": "ee-bin dev --serve=electron",
    "icon": "ee-bin icon",
    "re-sqlite": "electron-rebuild -f -w better-sqlite3",
    "build-electron-w": "bash ./scripts/build-electron.sh win64",
    "build-electron-m": "bash ./scripts/build-electron.sh mac",
    "build-electron-m-arm64": "bash ./scripts/build-electron.sh mac_arm64",
    "build-electron-l": "bash ./scripts/build-electron.sh linux"
  },
  "repository": "https://github.com/dromara/electron-egg.git",
  "keywords": [
    "Electron",
    "electron-egg",
    "ElectronEgg",
    "React",
    "AI marketing"
  ],
  "author": "",
  "license": "Apache",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "debug": "^4.4.0",
    "ee-bin": "^4.2.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.3.5",
    "sass": "^1.99.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "antd": "^6.3.7",
    "co": "^4.6.0",
    "ee-core": "^4.1.5",
    "electron-updater": "^6.7.3",
    "es-object-atoms": "^1.1.2",
    "lucide-react": "^0.468.0",
    "mime-db": "^1.54.0",
    "playwright-core": "^1.60.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.14.2",
    "tt-uploader": "^1.6.1"
  },
  "postinstall": "electron-builder install-app-deps"
}
