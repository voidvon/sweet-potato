{
  "name": "ai-marketing-desktop-server",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; const execPath = process.env.npm_execpath || ''; if (!ua.includes('pnpm/') && !execPath.includes('pnpm')) { console.error('检测到正在使用 npm。请使用 pnpm install'); process.exit(1); }\"",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.5",
    "@volcengine/ark-runtime": "^1.0.10",
    "@volcengine/openapi": "^1.36.2",
    "@volcengine/tos-sdk": "^2.9.1",
    "better-sqlite3": "12.5.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "jsonrepair": "^3.14.0",
    "multer": "^2.1.1",
    "sharp": "^0.35.3",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
